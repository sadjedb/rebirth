# Postgres connection string. Locally: postgresql://user:password@localhost:5432/mono_storefront
# In production: use your host's connection string (Vercel Postgres, Supabase, Neon, Railway, etc).
DATABASE_URL=

# Session signing secret — required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary — used for product media (images/video) uploads in the admin.
# Get these from your Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
